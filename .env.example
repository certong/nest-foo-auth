# ---------------------------------------------------------------------------
# Local environment
#
# Copy this file to .env and fill it in:
#
#   cp .env.example .env
#   npm start
#
# .env is the only env file, as in nest-foo-billing: `nest start` and the
# Prisma CLI both read it, so they always agree on which database they are
# talking to. To work against a different database, edit DATABASE_URL and
# DIRECT_URL together -- the boot log prints APP_ENV and the database host, so
# a wrong target shows on line one.
#
# Never keep alternates commented out inside the file. dotenv takes the LAST
# value of a repeated key, so a second DATABASE_URL quietly wins and the file
# stops meaning what it appears to say. This is not hypothetical -- the .env
# found here on 2026-10-19 declared APP_ENV=local over a local URL, then
# repeated DATABASE_URL and DIRECT_URL pointing at Neon dev with
# schema=billing. Only the boot guard that rejects a URL without schema=auth
# kept it from migrating auth tables into billing.
#
# Keep a second target in a file of your own if you need one (.env.dev is
# gitignored), but copy it over .env rather than switching with a script:
# there is one file, and the boot log says which database it reached.
# ---------------------------------------------------------------------------

# Identifies the active target in the boot log. Purely informational.
APP_ENV=local

# 3001 locally so it can run beside nest-foo-billing on 3000.
PORT=3001

# Pooled connection, used at runtime. On Neon this is the -pooler host.
#
# Both URLs end in schema=auth, and must. This service owns the `auth` schema
# of foo_platform (account, account_pin, auth_event) and keeps its own
# migration history at auth._prisma_migrations; billing owns `billing`. Leave
# schema=auth off and Prisma reads and migrates `public`, where nothing lives.
#
# USER would be `auth_svc` once docs/runbooks/auth-svc-role.md has been run in
# that environment. It has been run in none (FA-22; README, "The database role").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/foo_platform?sslmode=require&channel_binding=require&schema=auth"

# Direct connection, used only by `prisma migrate`. Same credentials, same
# database, same schema, on the non-pooler host.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/foo_platform?sslmode=require&channel_binding=require&schema=auth"

# The database is `foo_platform` -- the same one nest-foo-billing connects to.
# This service owns schema `auth` there; billing owns `billing`. It was called
# foo_platform_db while dev and UAT lived in us-east-2; those projects are
# retired, and nothing should be pointed at that name again. nest-foo-billing
# .env.example carries the exact per-target endpoints and roles, plus the one
# Neon caveat (the -pooler host drops the search_path it becomes), and is the
# place to copy a host from rather than assembling one by hand here.
#
# LOCAL IS NOT YET CONSISTENT with that: this repo has been pointed at a
# separate localhost database, `foo_auth_local`, while billing local target is
# `foo_platform`. Both work -- schema `auth` is self-contained and nothing in
# this service reads a billing table -- so it is a naming inconsistency, not a
# fault. To converge: `create database foo_platform`, change the name in .env,
# then `prisma migrate deploy`, which creates schema `auth`.

# This service's public URL. Goes in every token as `iss`, and is the `aud` of
# the refresh token. Billing and studio must be configured with exactly this
# value (their AUTH_ISSUER).
AUTH_ISSUER="http://localhost:3001"

# The ES256 private key every token is signed with, as a one-line JWK with a
# kid. SECRET: it exists only here -- billing and studio verify with the public
# half from /.well-known/jwks.json and never see this. Generate with:
#
#   npm run signing-key:generate
#
# One key per environment. Changing it signs everyone out everywhere.
AUTH_SIGNING_JWK=

# Read only by `npm run signing-key:generate`, never at runtime. Sets the `kid`
# of the key it prints; defaults to todays date (YYYY-MM-DD). Give it a value
# when rotating twice in one day, since the kid is what tells two keys apart
# in the JWKS:
#
#   SIGNING_KEY_ID=2026-10-b npm run signing-key:generate
# SIGNING_KEY_ID=

# Extra PUBLIC keys to publish in the JWKS, as a JSON array. Empty except while
# rotating the signing key (see README, "Rotating the signing key").
AUTH_PUBLISHED_JWKS=

# Which browser origins may call this service, and which portal each one is.
# Comma-separated origin=portal pairs; portals are billing and studio. This is
# also the CORS allowlist. A request from any other origin, or with none, is
# refused with 403 -- except GET /.well-known/jwks.json and GET /api/health.
#
# Origins only: scheme, host and port. No path, no trailing slash.
#
# Billing is listed twice, on 5173 and 5174. Vite takes the next free port
# when 5173 is busy, which happens whenever a second dev server runs -- a
# git worktree of react-foo-billing, or a server left running in another
# terminal. The second one then lands on 5174 and every auth call fails the
# preflight with no Access-Control-Allow-Origin, because this list IS the CORS
# allowlist. Listing both is what keeps that from being a half-hour of
# debugging; `strictPort: true` in the frontend vite config is the other half
# of the fix, and belongs in that repo.
#
# Note the billing frontend proxies /api to its own backend so the session
# cookie stays first-party, but reads this service from an absolute
# VITE_AUTH_URL -- so auth calls are cross-origin on purpose and do need to be
# listed here. The proxy does not cover them.
AUTH_PORTAL_ORIGINS="http://localhost:5173=billing,http://localhost:5174=billing,http://localhost:5182=studio"

# Refresh cookie posture. Deployed: true / lax. Local development is plain
# http, so secure stays false here.
#
# The portals and this service share one registrable domain (billing.<domain>,
# studio.<domain>, auth.<domain>), which makes them same-site: the host-only
# cookie on auth.<domain> is first-party and Lax is enough. Locally, every
# localhost port is the same site too.
#
# none is for a genuinely cross-site deployment, which this design does not
# support -- Safari blocks such cookies outright. The app also refuses none
# without secure=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# How long a browser may cache the CORS preflight, in seconds (CP-43). Every
# call to this service is cross-origin, so without this each one is preceded by
# an OPTIONS. Unset, empty or non-numeric falls back to 600.
CORS_MAX_AGE="600"

# Set to 1 when deployed behind a reverse proxy. Without it every request
# appears to come from the proxy: the login throttle becomes one global budget,
# and every auth_event row records the proxy's IP.
# TRUST_PROXY=1

# How many days of auth_event to keep. Default 365. The service prunes a minute
# after boot and every 24 hours; `npm run events:prune` does it on demand.
# AUTH_EVENT_RETENTION_DAYS=365

# Read only by `npm run seed:admin`, never at runtime. Creates or resets the
# password of one account (there is no password reset flow; this is it).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Read only by `npm run user:add` (and USER_EMAIL by user:disable / user:enable),
# never at runtime. Creates an additional login; refuses an address that
# already has one. USER_ACCOUNT_TYPE is staff (default: every portal) or client
# (studio only, scoped to USER_CLIENT_ID, the billing client's id).
USER_EMAIL=
USER_PASSWORD=
USER_ACCOUNT_TYPE=
USER_CLIENT_ID=

# Read only by `npm run key:set`, never at runtime. Sets the six-digit PIN for
# POST /auth/pin on the account named by USER_EMAIL above (staff or client).
# `npm run key:clear` removes the PIN of USER_EMAIL.
USER_PIN=

# Read only by `npm run test:db`. A Postgres server to create throwaway test
# databases on; the suite never touches foo_platform.
# TEST_DATABASE_URL="postgresql://foo:PASSWORD@localhost:5432/postgres"

# Read only by `npm run smoke`, never at runtime. Its first half (JWKS, CORS,
# the origin rule) needs no credentials; the sign-in half -- sign in, /me,
# refresh, sign out -- is skipped unless both are set. A real account on the
# target, so do not point these at production.
#
# Email and PIN, not a password: password sign-in is retired and /auth/login
# answers 403 everywhere. The email-bearing form works from either portal's
# origin, so the smoke does not need to know which it was pointed at.
# SMOKE_EMAIL=
# SMOKE_PIN=
