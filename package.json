{
  "name": "nest-foo-auth",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:admin": "ts-node -P tsconfig.json scripts/seed-admin.ts",
    "key:set": "ts-node -P tsconfig.json scripts/set-key.ts",
    "key:clear": "ts-node -P tsconfig.json scripts/clear-key.ts",
    "user:add": "ts-node -P tsconfig.json scripts/user-add.ts",
    "user:list": "ts-node -P tsconfig.json scripts/user-list.ts",
    "user:disable": "ts-node -P tsconfig.json scripts/user-disable.ts",
    "user:enable": "ts-node -P tsconfig.json scripts/user-disable.ts --enable",
    "signing-key:generate": "ts-node -P tsconfig.json scripts/generate-signing-key.ts",
    "events:prune": "ts-node -P tsconfig.json scripts/prune-events.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:db": "vitest run --config vitest.db.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "@swc/core@1.16.20": true,
    "prisma@7.10.1": true
  }
}
