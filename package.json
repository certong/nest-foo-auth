{
  "name": "nest-foo-auth",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "env:local": "scripts/use-env.sh local",
    "env:dev": "scripts/use-env.sh dev",
    "env:uat": "scripts/use-env.sh uat",
    "env:which": "scripts/use-env.sh",
    "postinstall": "prisma generate",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:admin": "ts-node -P tsconfig.json scripts/seed-admin.ts",
    "key:set": "ts-node -P tsconfig.json scripts/set-key.ts",
    "user:add": "ts-node -P tsconfig.json scripts/user-add.ts",
    "user:list": "ts-node -P tsconfig.json scripts/user-list.ts",
    "signing-key:generate": "ts-node -P tsconfig.json scripts/generate-signing-key.ts",
    "events:prune": "ts-node -P tsconfig.json scripts/prune-events.ts",
    "test:db": "vitest run --config vitest.db.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@swc/core@1.16.1": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true
  }
}
